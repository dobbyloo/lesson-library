{
  "name": "lesson-library",
  "private": true,
  "workspaces": [
    "api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w api --",
    "seed": "npm run seed -w api",
    "schema:dump": "npm run schema:dump -w api",
    "dev": "npm run dev -w api",
    "test": "npm test -w api",
    "typecheck": "npm run typecheck -w api"
  }
}
